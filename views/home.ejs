<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Beranda - Sekolah Tinggi JeWePe</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-primary sticky-top">
    <div class="container">
      <a class="navbar-brand" href="/home">
        <i class="fas fa-graduation-cap me-2"></i>Sekolah Tinggi JeWePe
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMain">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navMain">
        <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
          <li class="nav-item"><a class="nav-link active" href="/home">Home</a></li>
          <li class="nav-item"><a class="nav-link" href="/artikel">Artikel</a></li>
          <li class="nav-item">
            <a class="btn btn-light btn-sm px-3" href="/login"><i class="fas fa-sign-in-alt me-1"></i> Login</a>
          </li>
        </ul>
      </div>
    </div>
  </nav>

  <main>
    <section class="hero-section">
      <div class="container text-center">
        <h1 class="display-5 fw-bold mb-3">Selamat Datang di Website Sekolah Tinggi JeWePe</h1>
        <p class="lead mb-4 opacity-90">Portal informasi dan artikel kampus Gunadarma</p>
        <img src="/gunadarma.jpeg" alt="Logo Gunadarma" class="img-fluid mb-4" style="max-width: 520px;">
        <div>
          <a href="/artikel" class="btn btn-light btn-lg me-2">
            <i class="fas fa-newspaper me-2"></i>Lihat Artikel
          </a>
          <a href="/login" class="btn btn-outline-light btn-lg">
            <i class="fas fa-user-shield me-2"></i>Admin Login
          </a>
        </div>
      </div>
    </section>

    <section class="container py-5">
      <div class="row g-4 text-center">
        <div class="col-md-4">
          <div class="card h-100 border-0 shadow-sm p-4">
            <div class="text-primary mb-3"><i class="fas fa-book-open fa-3x"></i></div>
            <h5>Artikel Kampus</h5>
            <p class="text-muted mb-0">Baca berbagai artikel seputar teknologi, pendidikan, dan kegiatan kampus.</p>
          </div>
        </div>
        <div class="col-md-4">
          <div class="card h-100 border-0 shadow-sm p-4">
            <div class="text-primary mb-3"><i class="fas fa-comments fa-3x"></i></div>
            <h5>Interaksi</h5>
            <p class="text-muted mb-0">Berikan komentar dan diskusi pada setiap artikel yang menarik.</p>
          </div>
        </div>
        <div class="col-md-4">
          <div class="card h-100 border-0 shadow-sm p-4">
            <div class="text-primary mb-3"><i class="fas fa-cogs fa-3x"></i></div>
            <h5>Kelola Konten</h5>
            <p class="text-muted mb-0">Admin dapat menambah, mengubah, dan menghapus artikel dengan mudah.</p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="py-4">
    <div class="container text-center">
      <div class="mb-2">
        <a href="/home" class="me-3">Home</a>
        <a href="/artikel" class="me-3">Artikel</a>
        <a href="/login">Login</a>
      </div>
      <p class="mb-0 small">&copy; 2023–2025 Sekolah Tinggi JeWePe · Ilham Oktavian</p>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
