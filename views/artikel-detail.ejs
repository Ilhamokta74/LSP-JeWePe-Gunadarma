<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Detail Artikel - JeWePe</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-primary sticky-top">
    <div class="container">
      <a class="navbar-brand" href="/home">
        <i class="fas fa-graduation-cap me-2"></i>Sekolah Tinggi JeWePe
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMain">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navMain">
        <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
          <li class="nav-item"><a class="nav-link" href="/home">Home</a></li>
          <li class="nav-item"><a class="nav-link active" href="/artikel">Artikel</a></li>
          <li class="nav-item">
            <a class="btn btn-light btn-sm px-3" href="/login"><i class="fas fa-sign-in-alt me-1"></i> Login</a>
          </li>
        </ul>
      </div>
    </div>
  </nav>

  <main class="container py-4">
    <% getDetails.forEach(function(getDetail) { %>
      <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/home">Home</a></li>
          <li class="breadcrumb-item"><a href="/artikel">Artikel</a></li>
          <li class="breadcrumb-item active"><%= getDetail.judul %></li>
        </ol>
      </nav>

      <article class="article-detail mb-5">
        <% if (getDetail.image) { %>
          <img src="/uploads/<%= getDetail.image %>" alt="<%= getDetail.judul %>" class="mb-4 shadow-sm"
               onerror="this.style.display='none'">
        <% } %>
        <h1 class="fw-bold mb-3"><%= getDetail.judul %></h1>
        <div class="article-content">
          <p style="white-space: pre-wrap;"><%= getDetail.artikel %></p>
        </div>
      </article>
    <% }) %>

    <!-- Komentar -->
    <section class="mb-5">
      <h3 class="fw-bold mb-4">
        <i class="fas fa-comments text-primary me-2"></i>
        Komentar (<%= komentars.length %>)
      </h3>

      <% if (komentars.length === 0) { %>
        <p class="text-muted">Belum ada komentar. Jadilah yang pertama!</p>
      <% } else { %>
        <div class="row g-3">
          <% komentars.forEach(function(komentar) { %>
            <div class="col-12">
              <div class="card comment-card shadow-sm">
                <div class="card-body">
                  <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                      <strong><%= komentar.nama %></strong>
                      <span class="text-muted small ms-2"><%= komentar.email %></span>
                    </div>
                  </div>
                  <p class="mb-0"><%= komentar.komentar %></p>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </section>

    <!-- Form Komentar -->
    <section class="card shadow-sm border-0 mb-5">
      <div class="card-body p-4">
        <h4 class="fw-bold mb-3">Tulis Komentar</h4>
        <form action="/input-komentar" method="post">
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label">Nama</label>
              <input type="text" class="form-control" name="komentarNama" placeholder="Nama Anda" required>
            </div>
            <div class="col-md-6">
              <label class="form-label">Email</label>
              <input type="email" class="form-control" name="komentarEmail" placeholder="email@example.com" required>
            </div>
            <div class="col-12">
              <label class="form-label">Komentar</label>
              <textarea class="form-control" name="komentar" rows="4" placeholder="Tulis komentar Anda..." maxlength="300" required></textarea>
            </div>
            <% getDetails.forEach(function(getDetail) { %>
              <input type="hidden" name="id" value="<%= getDetail.ID_artikel %>">
            <% }) %>
            <div class="col-12">
              <button type="submit" class="btn btn-primary">
                <i class="fas fa-paper-plane me-1"></i> Kirim Komentar
              </button>
            </div>
          </div>
        </form>
      </div>
    </section>
  </main>

  <footer class="py-4">
    <div class="container text-center">
      <div class="mb-2">
        <a href="/home" class="me-3">Home</a>
        <a href="/artikel">Artikel</a>
      </div>
      <p class="mb-0 small">&copy; 2023–2025 Sekolah Tinggi JeWePe</p>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
