<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Kelola Artikel - Admin JeWePe</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-primary sticky-top">
    <div class="container">
      <a class="navbar-brand" href="/home-admin">
        <i class="fas fa-graduation-cap me-2"></i>JeWePe Admin
        <span class="admin-badge ms-2">ADMIN</span>
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMain">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navMain">
        <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
          <li class="nav-item"><a class="nav-link" href="/home-admin">Dashboard</a></li>
          <li class="nav-item"><a class="nav-link active" href="/artikel-kelola">Kelola Artikel</a></li>
          <li class="nav-item">
            <a class="btn btn-outline-light btn-sm px-3" href="/home" onclick="return confirm('Yakin ingin logout?')">
              <i class="fas fa-sign-out-alt me-1"></i> Logout
            </a>
          </li>
        </ul>
      </div>
    </div>
  </nav>

  <main class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
      <h2 class="fw-bold mb-0">
        <i class="fas fa-list text-primary me-2"></i>Kelola Artikel
      </h2>
      <a href="/artikel-input" class="btn btn-success">
        <i class="fas fa-plus me-1"></i> Artikel Baru
      </a>
    </div>

    <% if (artikels.length === 0) { %>
      <div class="empty-state">
        <i class="fas fa-inbox fa-3x mb-3 text-secondary"></i>
        <h5>Belum ada artikel</h5>
        <a href="/artikel-input" class="btn btn-primary mt-2">Buat Artikel Pertama</a>
      </div>
    <% } else { %>
      <div class="card border-0 shadow-sm">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead>
              <tr>
                <th class="text-center" style="width:70px">ID</th>
                <th>Judul</th>
                <th class="text-center" style="width:100px">Gambar</th>
                <th class="text-center" style="width:180px">Aksi</th>
              </tr>
            </thead>
            <tbody>
              <% artikels.forEach(function(artikel) { %>
                <tr>
                  <td class="text-center fw-medium"><%= artikel.ID_artikel %></td>
                  <td><%= artikel.judul %></td>
                  <td class="text-center">
                    <% if (artikel.image) { %>
                      <img src="/uploads/<%= artikel.image %>" alt="" style="width:48px;height:48px;object-fit:cover;border-radius:6px;"
                           onerror="this.style.display='none'">
                    <% } else { %>
                      <span class="text-muted small">—</span>
                    <% } %>
                  </td>
                  <td class="text-center">
                    <a href="/artikel-edit/<%= artikel.ID_artikel %>" class="btn btn-sm btn-primary me-1" title="Edit">
                      <i class="fas fa-edit"></i>
                    </a>
                    <form action="/artikel-delete" method="post" class="d-inline" onsubmit="return confirm('Yakin hapus artikel ini beserta komentarnya?')">
                      <input type="hidden" name="id" value="<%= artikel.ID_artikel %>">
                      <button type="submit" class="btn btn-sm btn-danger" title="Hapus">
                        <i class="fas fa-trash"></i>
                      </button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>
  </main>

  <footer class="py-4">
    <div class="container text-center">
      <p class="mb-0 small">&copy; 2023–2025 Sekolah Tinggi JeWePe · Admin Panel</p>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
