<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard Admin - JeWePe</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-primary sticky-top">
    <div class="container">
      <a class="navbar-brand" href="/home-admin">
        <i class="fas fa-graduation-cap me-2"></i>JeWePe Admin
        <span class="admin-badge ms-2">ADMIN</span>
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMain">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navMain">
        <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
          <li class="nav-item"><a class="nav-link active" href="/home-admin">Dashboard</a></li>
          <li class="nav-item"><a class="nav-link" href="/artikel-kelola">Kelola Artikel</a></li>
          <li class="nav-item">
            <a class="btn btn-outline-light btn-sm px-3" href="/home" onclick="return confirm('Yakin ingin logout?')">
              <i class="fas fa-sign-out-alt me-1"></i> Logout
            </a>
          </li>
        </ul>
      </div>
    </div>
  </nav>

  <main>
    <section class="hero-section">
      <div class="container text-center">
        <h1 class="display-5 fw-bold mb-3">Dashboard Admin</h1>
        <p class="lead mb-4 opacity-90">Kelola konten website Sekolah Tinggi JeWePe</p>
        <img src="/gunadarma.jpeg" alt="Logo" class="img-fluid mb-4" style="max-width: 420px;">
        <div>
          <a href="/artikel-kelola" class="btn btn-light btn-lg me-2">
            <i class="fas fa-list me-2"></i>Kelola Artikel
          </a>
          <a href="/artikel-input" class="btn btn-outline-light btn-lg">
            <i class="fas fa-plus me-2"></i>Tambah Artikel
          </a>
        </div>
      </div>
    </section>

    <section class="container py-5">
      <div class="row g-4">
        <div class="col-md-4">
          <a href="/artikel-kelola" class="text-decoration-none">
            <div class="card h-100 border-0 shadow-sm p-4 text-center hover-lift">
              <div class="text-primary mb-3"><i class="fas fa-newspaper fa-3x"></i></div>
              <h5 class="text-dark">Kelola Artikel</h5>
              <p class="text-muted mb-0">Lihat, edit, dan hapus artikel yang sudah ada.</p>
            </div>
          </a>
        </div>
        <div class="col-md-4">
          <a href="/artikel-input" class="text-decoration-none">
            <div class="card h-100 border-0 shadow-sm p-4 text-center">
              <div class="text-success mb-3"><i class="fas fa-plus-circle fa-3x"></i></div>
              <h5 class="text-dark">Tambah Artikel</h5>
              <p class="text-muted mb-0">Buat artikel baru lengkap dengan gambar.</p>
            </div>
          </a>
        </div>
        <div class="col-md-4">
          <a href="/artikel" class="text-decoration-none">
            <div class="card h-100 border-0 shadow-sm p-4 text-center">
              <div class="text-info mb-3"><i class="fas fa-eye fa-3x"></i></div>
              <h5 class="text-dark">Lihat Website</h5>
              <p class="text-muted mb-0">Buka halaman publik untuk melihat hasilnya.</p>
            </div>
          </a>
        </div>
      </div>
    </section>
  </main>

  <footer class="py-4">
    <div class="container text-center">
      <p class="mb-0 small">&copy; 2023–2025 Sekolah Tinggi JeWePe · Admin Panel</p>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
