<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tambah Artikel - Admin JeWePe</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-primary sticky-top">
    <div class="container">
      <a class="navbar-brand" href="/home-admin">
        <i class="fas fa-graduation-cap me-2"></i>JeWePe Admin
        <span class="admin-badge ms-2">ADMIN</span>
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMain">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navMain">
        <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
          <li class="nav-item"><a class="nav-link" href="/home-admin">Dashboard</a></li>
          <li class="nav-item"><a class="nav-link" href="/artikel-kelola">Kelola Artikel</a></li>
          <li class="nav-item">
            <a class="btn btn-outline-light btn-sm px-3" href="/home" onclick="return confirm('Yakin ingin logout?')">
              <i class="fas fa-sign-out-alt me-1"></i> Logout
            </a>
          </li>
        </ul>
      </div>
    </div>
  </nav>

  <main class="container py-4">
    <div class="mb-4">
      <a href="/artikel-kelola" class="text-decoration-none text-muted">
        <i class="fas fa-arrow-left me-1"></i> Kembali ke Kelola Artikel
      </a>
    </div>

    <div class="card border-0 shadow-sm">
      <div class="card-body p-4 p-md-5">
        <h2 class="fw-bold mb-4">
          <i class="fas fa-plus-circle text-success me-2"></i>Tambah Artikel Baru
        </h2>

        <form action="/artikel-input" method="post" enctype="multipart/form-data">
          <div class="mb-3">
            <label for="judul" class="form-label fw-medium">Judul Artikel</label>
            <input type="text" class="form-control form-control-lg" id="judul" name="judul"
                   placeholder="Masukkan judul artikel" required>
          </div>

          <div class="mb-3">
            <label for="image" class="form-label fw-medium">Gambar (opsional)</label>
            <input type="file" class="form-control" id="image" name="image" accept="image/*">
            <div class="form-text">Format: JPG, PNG. Disarankan rasio 16:9.</div>
          </div>

          <div class="mb-4">
            <label for="artikel" class="form-label fw-medium">Isi Artikel</label>
            <textarea class="form-control" id="artikel" name="artikel" rows="12"
                      placeholder="Tulis isi artikel di sini..." required></textarea>
          </div>

          <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary px-4">
              <i class="fas fa-save me-1"></i> Simpan Artikel
            </button>
            <a href="/artikel-kelola" class="btn btn-outline-secondary">Batal</a>
          </div>
        </form>
      </div>
    </div>
  </main>

  <footer class="py-4">
    <div class="container text-center">
      <p class="mb-0 small">&copy; 2023–2025 Sekolah Tinggi JeWePe · Admin Panel</p>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
