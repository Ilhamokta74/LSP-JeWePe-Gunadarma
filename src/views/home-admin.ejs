<%- include('partials/head', { title: 'Dashboard' }) %>
<%- include('partials/nav', { admin: true }) %>
<section class="container section">
  <div class="section-head">
    <div>
      <h1>Dashboard</h1>
      <p class="muted">Halo, <%= user.email %>. Ringkasan aktivitas situs.</p>
    </div>
    <a class="btn btn-primary" href="/artikel-input">+ Artikel baru</a>
  </div>

  <div class="stats">
    <div class="card stat"><span class="muted">Total artikel</span><strong><%= stats.artikel %></strong><a class="link-arrow" href="/artikel-kelola">Kelola →</a></div>
    <div class="card stat"><span class="muted">Total komentar</span><strong><%= stats.komentar %></strong><span class="muted small">dari semua artikel</span></div>
  </div>

  <h2 class="mt">Komentar terbaru</h2>
  <% if (recent.length) { %>
    <ul class="card list">
      <% recent.forEach(k => { %>
        <li>
          <div>
            <strong><%= k.nama %></strong> pada
            <a href="/artikel-edit/<%= k.ID_artikel %>#komentar"><%= k.judul || 'Artikel dihapus' %></a>
            <p class="muted"><%= excerpt(k.komentar, 100) %></p>
          </div>
        </li>
      <% }) %>
    </ul>
  <% } else { %>
    <div class="empty"><p class="muted">Belum ada komentar.</p></div>
  <% } %>
</section>
<%- include('partials/footer') %>
